module {
  hw.module private @module1(in %clk : i1, in %rst : i1, in %data_in : i4, out data_out : i4) {
    %0 = llhd.constant_time <0ns, 0d, 1e>
    %c0_i28 = hw.constant 0 : i28
    %1 = llhd.constant_time <0ns, 1d, 0e>
    %true = hw.constant true
    %c1_i32 = hw.constant 1 : i32
    %c0_i4 = hw.constant 0 : i4
    %c3_i4 = hw.constant 3 : i4
    %false = hw.constant false
    %2 = comb.xor bin %clk, %true : i1
    %3 = comb.xor bin %rst, %true : i1
    %4 = comb.and bin %2, %clk : i1
    %5 = comb.and bin %3, %rst : i1
    %6 = comb.or bin %4, %5 : i1
    %7 = comb.concat %c0_i28, %data_in : i28, i4
    %8 = comb.add %7, %c1_i32 : i32
    %9 = comb.extract %8 from 0 : (i32) -> i4
    %10 = comb.xor %9, %c3_i4 : i4
    %true_0 = hw.constant true
    %false_1 = hw.constant false
    %false_2 = hw.constant false
    %11 = comb.and %6, %rst : i1
    %false_3 = hw.constant false
    %true_4 = hw.constant true
    %12 = comb.xor %rst, %true_4 : i1
    %13 = comb.and %6, %12 : i1
    %14 = comb.mux %13, %10, %c0_i4 : i4
    %15 = comb.or %13, %11 : i1
    %true_5 = hw.constant true
    %16 = seq.to_clock %rst
    %17 = seq.compreg %14, %16 reset %clk, %14 : i4  
    %18 = llhd.delay %17 by <0ns, 1d, 0e> : i4
    hw.output %18 : i4
  }
  hw.module private @module2(in %clk : i1, in %rst : i1, in %data_in : i4, out data_out : i4) {
    %0 = llhd.constant_time <0ns, 0d, 1e>
    %c-1_i4 = hw.constant -1 : i4
    %c0_i28 = hw.constant 0 : i28
    %1 = llhd.constant_time <0ns, 1d, 0e>
    %true = hw.constant true
    %c1_i4 = hw.constant 1 : i4
    %c0_i4 = hw.constant 0 : i4
    %c1_i32 = hw.constant 1 : i32
    %false = hw.constant false
    %2 = comb.extract %c1_i32 from 4 : (i32) -> i28
    %3 = comb.icmp eq %2, %c0_i28 : i28
    %4 = comb.extract %c1_i32 from 0 : (i32) -> i4
    %5 = comb.mux %3, %4, %c-1_i4 : i4
    %6 = comb.xor bin %clk, %true : i1
    %7 = comb.xor bin %rst, %true : i1
    %8 = comb.and bin %6, %clk : i1
    %9 = comb.and bin %7, %rst : i1
    %10 = comb.or bin %8, %9 : i1
    %11 = comb.shl %data_in, %5 : i4
    %12 = comb.or %11, %c1_i4 : i4
    %true_0 = hw.constant true
    %false_1 = hw.constant false
    %false_2 = hw.constant false
    %13 = comb.and %10, %rst : i1
    %false_3 = hw.constant false
    %true_4 = hw.constant true
    %14 = comb.xor %rst, %true_4 : i1
    %15 = comb.and %10, %14 : i1
    %16 = comb.mux %15, %12, %c0_i4 : i4
    %17 = comb.or %15, %13 : i1
    %true_5 = hw.constant true
    %18 = seq.to_clock %rst
    %19 = seq.compreg %16, %18 reset %clk, %16 : i4  
    %20 = llhd.delay %19 by <0ns, 1d, 0e> : i4
    hw.output %20 : i4
  }
  hw.module private @module3(in %clk : i1, in %rst : i1, in %data_in : i4, out data_out : i4) {
    %0 = llhd.constant_time <0ns, 0d, 1e>
    %1 = llhd.constant_time <0ns, 1d, 0e>
    %true = hw.constant true
    %c3_i4 = hw.constant 3 : i4
    %c-6_i4 = hw.constant -6 : i4
    %c0_i4 = hw.constant 0 : i4
    %false = hw.constant false
    %2 = comb.xor bin %clk, %true : i1
    %3 = comb.xor bin %rst, %true : i1
    %4 = comb.and bin %2, %clk : i1
    %5 = comb.and bin %3, %rst : i1
    %6 = comb.or bin %4, %5 : i1
    %7 = comb.xor %data_in, %c-6_i4 : i4
    %8 = comb.add %7, %c3_i4 : i4
    %true_0 = hw.constant true
    %false_1 = hw.constant false
    %false_2 = hw.constant false
    %9 = comb.and %6, %rst : i1
    %false_3 = hw.constant false
    %true_4 = hw.constant true
    %10 = comb.xor %rst, %true_4 : i1
    %11 = comb.and %6, %10 : i1
    %12 = comb.mux %11, %8, %c0_i4 : i4
    %13 = comb.or %11, %9 : i1
    %true_5 = hw.constant true
    %14 = seq.to_clock %rst
    %15 = seq.compreg %12, %14 reset %clk, %12 : i4  
    %16 = llhd.delay %15 by <0ns, 1d, 0e> : i4
    hw.output %16 : i4
  }
  hw.module @module4(in %clk : i1, in %rst : i1, in %in_data : i4, out out_data : i4) {
    %u1.data_out = hw.instance "u1" @module1(clk: %clk: i1, rst: %rst: i1, data_in: %in_data: i4) -> (data_out: i4) {sv.namehint = "interconnect1"}
    %u2.data_out = hw.instance "u2" @module2(clk: %clk: i1, rst: %rst: i1, data_in: %u1.data_out: i4) -> (data_out: i4) {sv.namehint = "interconnect2"}
    %u3.data_out = hw.instance "u3" @module3(clk: %clk: i1, rst: %rst: i1, data_in: %u2.data_out: i4) -> (data_out: i4)
    hw.output %u3.data_out : i4
  }
}

